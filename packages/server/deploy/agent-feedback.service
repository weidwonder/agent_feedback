[Unit]
Description=Agent Feedback 收集服务
After=network.target

[Service]
Type=simple
User=agent-feedback
Group=agent-feedback
WorkingDirectory=/opt/agent-feedback
# node:sqlite 在 Node 22 会打印实验性警告，无害，这里关掉以免刷屏
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/agent-feedback/packages/server/dist/server.mjs serve
Restart=always
RestartSec=3

# 环境变量（含义见 docs/deploy.md）
Environment=PORT=8787
Environment=HOST=127.0.0.1
Environment=DATA_DIR=/var/lib/agent-feedback
Environment=TRUST_PROXY=1
Environment=COOKIE_SECURE=1
Environment=IP_DAILY_LIMIT=50
Environment=GLOBAL_DAILY_LIMIT=500

# 基本加固：只允许写数据目录
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agent-feedback

[Install]
WantedBy=multi-user.target
