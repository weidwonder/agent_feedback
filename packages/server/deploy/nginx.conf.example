# 把 fb.example.com 与证书路径换成实际值。
server {
    listen 443 ssl;
    server_name fb.example.com;

    ssl_certificate     /etc/letsencrypt/live/fb.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fb.example.com/privkey.pem;

    client_max_body_size 128k;

    # 关闭访问日志：避免代理日志长期留存提交方网络地址（隐私说明承诺地址计数 30 天删除）
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        # $proxy_add_x_forwarded_for 把真实来源地址追加在末尾；服务端取最后一段，配 TRUST_PROXY=1
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name fb.example.com;
    access_log off;
    return 301 https://$host$request_uri;
}
